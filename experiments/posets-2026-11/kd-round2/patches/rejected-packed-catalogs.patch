+  template <bool Cascade>
+  void bridge_width_boundaries () {
+    using vector_type = posets::vectors::vector_backed<int16_t>;
+    using tree_type = posets::utils::bucket_kdtree<vector_type, Cascade>;
+    for (const size_t leaf_size : {1U, 16U, 255U, 256U})
+      for (const size_t count : {0U, 1U, 31U, 32U, 33U, 510U, 511U, 512U, 513U}) {
+        std::vector<vector_type> points;
+        std::vector<uint32_t> ids (count);
+        std::iota (ids.begin (), ids.end (), 0);
+        region rows;
+        for (size_t i = 0; i < count; ++i) {
+          rows.push_back ({i < count / 2 ? -10 : 10, static_cast<int> (i % 63) - 31});
+          points.push_back (vector<vector_type> (rows.back ()));
+        }
+        const auto get = [&] (uint32_t id) -> const vector_type& { return points[id]; };
+        const auto live = [] (uint32_t) { return true; };
+        tree_type tree;
+        tree.rebuild (ids, 2, leaf_size, get);
+        const auto stats = tree.storage ();
+        require (stats.bridge_entry_bytes == (Cascade ? (leaf_size <= 255 ? 2U : 8U) : 0U),
+                 "wrong selected FC bridge width");
+        if constexpr (not Cascade)
+          require (stats.bridge_bytes == 0, "independent search allocated bridges");
+        for (const int key : {-32768, -11, -10, -9, 0, 9, 10, 11, 32767}) {
+          require (tree.check_bridges (static_cast<int16_t> (key), false) and
+                       tree.check_bridges (static_cast<int16_t> (key), true),
+                   "packed/general bridge correction mismatch");
+          for (const int second : {-32, 0, 32}) {
+            const logical raw {key, second};
+            const auto query = vector<vector_type> (raw);
+            for (const bool strict : {false, true}) {
+              const bool expected = std::ranges::any_of (rows, [&] (const auto& row) {
+                return below (raw, row) and (not strict or raw != row);
+              });
+              require (tree.dominates (query, get, live, strict) == expected,
+                       "packed/general bridge dominance differs");
+            }
+            std::set<uint32_t> actual, expected;
+            tree.dominated_by (query, get, live, [&] (uint32_t id) {
+              require (actual.insert (id).second, "retirement report repeated an ID");
+            });
+            for (const auto id : ids)
+              if (below (rows[id], raw))
+                expected.insert (id);
+            require (actual == expected, "packed/general bridge report differs");
+          }
+        }
+      }
+  }
