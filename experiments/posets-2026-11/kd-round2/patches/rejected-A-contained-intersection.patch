+  template <class V, bool Cascade>
+  void intersection_prefix () {
+    using set_type = posets::downsets::lazy_kdtree_backed<V, Cascade>;
+    posets::downsets::lazy_kdtree_policy policy;
+    policy.leaf_size = 2;
+    policy.min_index_size = 3;
+    const region rows {{4, 0, 0}, {3, 1, 0}, {2, 2, 0}, {1, 3, 0}, {0, 4, 0}};
+    for (const size_t prefix : {0U, 2U, 4U}) {
+      std::vector<V> values;
+      for (const auto& row : rows)
+        values.push_back (vector<V> (row));
+      set_type subject (std::move (values), policy);
+      region rhs (rows.begin (), rows.begin () + static_cast<std::ptrdiff_t> (prefix));
+      rhs.push_back ({-1, -1, -1});
+      auto other = build<set_type> (rhs);
+      region expected;
+      for (const auto& lhs : rows)
+        for (const auto& right : rhs) {
+          logical met;
+          for (size_t d = 0; d < lhs.size (); ++d)
+            met.push_back (std::min (lhs[d], right[d]));
+          expected.push_back (std::move (met));
+        }
+      subject.intersect_with (other);
+      auto probes = expected;
+      probes.insert (probes.end (), rows.begin (), rows.end ());
+      observe (subject, expected, probes);
+      observe (other, rhs, probes);
+    }
+  }
