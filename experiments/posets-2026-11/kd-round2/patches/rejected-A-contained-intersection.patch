+  template <class V, bool Cascade>
+  void contained_intersection () {
+    using set_type = posets::downsets::lazy_kdtree_backed<V, Cascade>;
+    for (const size_t minimum : {3U, 100U}) {
+      posets::downsets::lazy_kdtree_policy policy;
+      policy.min_index_size = minimum;
+      policy.leaf_size = 2;
+      std::vector<V> input;
+      for (const auto& row : original ())
+        input.push_back (vector<V> (row));
+      set_type subject (std::move (input), policy);
+      subject.rebuild ();
+      auto other = build<set_type> ({{20, 20, 20}});
+      const auto* backing = subject.get_backing_vector ().data ();
+      const auto before = subject.storage ();
+      allocations_left = 0;
+      subject.intersect_with (other);
+      subject.intersect_with (subject);
+      allocations_left = -1;
+      const auto after = subject.storage ();
+      require (subject.get_backing_vector ().data () == backing and
+                   before.known_retained_bytes == after.known_retained_bytes and
+                   before.rebuilds == after.rebuilds and before.compactions == after.compactions and
+                   before.created_ids == after.created_ids,
