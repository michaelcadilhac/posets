+namespace posets::downsets {
+  // Optional frozen-leaf coordinate filter. Scalar and SIMD modes retain the
+  // same columns/geometry and confirm every surviving live point with full order.
+  template <Vector V, size_t Columns = 2, bool Simd = true, bool Cascade = true>
+  using block_lazy_kdtree_backed = lazy_kdtree_backed<V, Cascade, Columns, Simd>;
+
+  template <Vector V>
+  using block_lazy_kdtree_1_scalar = block_lazy_kdtree_backed<V, 1, false>;
+  template <Vector V>
+  using block_lazy_kdtree_1_simd = block_lazy_kdtree_backed<V, 1, true>;
+  template <Vector V>
+  using block_lazy_kdtree_2_scalar = block_lazy_kdtree_backed<V, 2, false>;
+  template <Vector V>
+  using block_lazy_kdtree_2_simd = block_lazy_kdtree_backed<V, 2, true>;
+}
