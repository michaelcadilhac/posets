index 0000000000000000000000000000000000000000..b63474ef6f930254a6da7d0d52d9e7a9854c4b40
--- /dev/null
+++ b/tests/block-lazy-kdtree.cc
@@ -0,0 +1,229 @@
+#include "matrix-check.hh"
+
+#include <iostream>
+#include <limits>
+#include <optional>
+#include <set>
+#include <type_traits>
+
+#include <posets/downsets/block_lazy_kdtree_backed.hh>
+#include <posets/vectors.hh>
+
+size_t posets::vectors::bool_threshold = 0;
+size_t posets::vectors::bitset_threshold = 0;
+
+namespace {
+  using matrix_check::require;
+  template <class Row>
+  bool below (const Row& a, const Row& b) {
+    for (size_t d = 0; d < a.size (); ++d)
+      if (a[d] > b[d])
+        return false;
+    return true;
+  }
+
+  template <class V, bool Cascade, size_t Columns, bool Simd>
+  void oracle (bool boolean = false, bool extremes = false) {
+    using coordinate_type = V::value_type;
+    using row_type = std::vector<coordinate_type>;
+    using tree_type = posets::utils::bucket_kdtree<V, Cascade, Columns, Simd>;
+    using plain_type = posets::utils::bucket_kdtree<V, Cascade>;
+    constexpr bool supported = Columns != 0 and std::is_integral_v<coordinate_type> and
+                               std::is_signed_v<coordinate_type> and sizeof (coordinate_type) <= 8;
+    if constexpr (not supported)
+      static_assert (sizeof (tree_type) == sizeof (plain_type));
+    for (const size_t dim : {1U, 2U, 3U, 17U, 33U, 65U})
+      for (const size_t count : {1U, 15U, 16U, 17U, 31U, 33U})
+        for (const size_t leaf : {2U, 15U, 16U, 17U, 31U}) {
+          std::vector<row_type> rows;
+          std::vector<std::optional<V>> points (count);
+          std::vector<uint32_t> ids (count);
+          std::vector<bool> alive (count, true);
+          std::vector<bool> registered (count, true);
+          for (size_t i = 0; i < count; ++i) {
+            ids[i] = static_cast<uint32_t> (i);
+            row_type row (dim);
+            for (size_t d = 0; d < dim; ++d) {
+              int coordinate;
+              if (boolean)
+                coordinate = static_cast<int> ((i + d) % 2) - 1;
+              else if (d == 0)
+                coordinate = static_cast<int> (i) - static_cast<int> (count / 2);
+              else if (d == 1)
+                coordinate = static_cast<int> (count / 2) - static_cast<int> (i);
+              else
+                coordinate = static_cast<int> ((i * (d + 3)) % 7) - 3;
+              row[d] = static_cast<coordinate_type> (coordinate);
+            }
+            if constexpr (std::is_floating_point_v<coordinate_type>)
+              for (auto& coordinate : row)
+                coordinate *= static_cast<coordinate_type> (0.25);
+            if (extremes and i < 3) {
+              const auto high = std::numeric_limits<coordinate_type>::max ();
+              std::ranges::fill (row,
+                                 i == 0 ? std::numeric_limits<coordinate_type>::lowest () : high);
+              if (i == 2)
+                row.back () = static_cast<coordinate_type> (high - 1);
+            }
+            rows.push_back (row);
+            points[i].emplace (std::span<const coordinate_type> (row));
+          }
+          const auto get = [&] (uint32_t id) -> const V& {
+            require (alive[id] and points[id].has_value (), "filter accessed retired payload");
+            return *points[id];
+          };
+          const auto live = [&] (uint32_t id) { return alive[id]; };
+          tree_type tree;
+          tree.rebuild (ids, dim, leaf, get);
+          const auto storage = tree.storage ();
+          const size_t expected_columns =
+              supported and dim > 1 ? 1 + static_cast<size_t> (Columns == 2 and dim > 3) : 0;
+          require (storage.filter_columns == expected_columns, "wrong effective filter axes");
+          require (storage.filter_bytes >= count * expected_columns * sizeof (coordinate_type),
+                   "filter capacity accounting omitted labels");
+          if (expected_columns == 0)
+            require (storage.filter_bytes == 0, "fallback allocated unused filter columns");
+          tree_type live_copy = tree;
+          tree_type live_move (std::move (live_copy));
+          // The utility promises empty, reusable moved-from state.
+          // NOLINTNEXTLINE(bugprone-use-after-move,clang-analyzer-cplusplus.Move)
+          require (live_copy.live_size () == 0 and live_move.live_size () == count,
+                   "live filter move lost its registered points");
+          tree_type swapped;
+          swapped.swap (live_move);
+          tree = std::move (swapped);
+
+          auto queries = rows;
+          queries.emplace_back (dim, static_cast<coordinate_type> (boolean ? -1 : -4));
+          queries.emplace_back (dim, static_cast<coordinate_type> (boolean ? 0 : 4));
+          const auto check = [&] {
+            for (const auto& raw : queries) {
+              const V query {std::span<const coordinate_type> (raw)};
+              for (const bool strict : {false, true}) {
+                const bool expected = std::ranges::any_of (ids, [&] (uint32_t id) {
+                  return alive[id] and below (raw, rows[id]) and (not strict or raw != rows[id]);
+                });
+                require (tree.dominates (query, get, live, strict) == expected,
+                         "leaf filter changed exact/strict dominance");
+              }
+              std::set<uint32_t> expected;
+              std::set<uint32_t> actual;
+              for (const auto id : ids)
+                if (alive[id] and below (rows[id], raw))
+                  expected.insert (id);
+              tree.dominated_by (query, get, live, [&] (uint32_t id) {
+                require (actual.insert (id).second, "leaf filter reported an ID twice");
+              });
+              require (actual == expected, "leaf filter changed dominated-ID reporting");
+            }
+          };
+          check ();
+          // Live may be stricter than the tree's registered retirement count.
+          alive[count / 2] = false;
+          points[count / 2].reset ();
+          check ();
+          size_t remaining = count;
+          for (const auto id : ids) {
+            alive[id] = false;
+            points[id].reset ();
+            if (registered[id]) {
+              registered[id] = false;
+              --remaining;
+            }
+            tree.retire (id);
+            tree.retire (id);
+            require (tree.live_size () == remaining, "filter retirement changed exact count");
+            if (remaining == count / 2 or remaining == 0)
+              check ();
+          }
+          tree_type copied = tree;
+          tree_type moved (std::move (copied));
+          tree = std::move (moved);
+          // Check both documented moved-from utility states.
+          // NOLINTNEXTLINE(bugprone-use-after-move)
+          require (copied.live_size () == 0 and moved.live_size () == 0 and tree.live_size () == 0,
+                   "filter move/copy duplicated liveness");
+#if POSETS_LAZY_KDTREE_STATS
+          const auto stats = tree.query_statistics ();
+          require (stats.filter_survivors <=
+                       stats.filter_simd_active_lanes + stats.filter_scalar_active_lanes,
+                   "filter survivor accounting exceeds active candidates");
+          if (storage.filter_lanes <= 1)
+            require (stats.filter_simd_chunks == 0, "scalar filter executed SIMD chunks");
+          if (storage.filter_lanes > 1 and count == 17 and leaf == 31)
+            require (stats.filter_simd_chunks > 0, "whole-leaf filter never used SIMD");
+#endif
+        }
+  }
+
+  template <class V>
+  void algebra () {
+    using set_type = posets::downsets::block_lazy_kdtree_backed<V>;
+    static_assert (posets::Downset<set_type>);
+    using namespace matrix_check;
+    region rows;
+    for (size_t i = 0; i < 17; ++i) {
+      logical row (17, -1);
+      row[i] = 0;
+      rows.push_back (std::move (row));
+    }
+    posets::downsets::lazy_kdtree_policy policy;
+    policy.min_index_size = 2;
+    policy.leaf_size = 17;
+    std::vector<V> input;
+    for (const auto& row : rows)
+      input.push_back (vector<V> (row));
+    set_type subject (std::move (input), policy);
+    check (subject, rows, rows);
+    auto image = subject.apply ([] (const V& value) { return value.copy (); });
+    check (image, rows, rows);
+    auto moved = std::move (image);
+    // The downset promises an empty, reusable moved-from state.
+    // NOLINTNEXTLINE(bugprone-use-after-move)
+    require (image.empty (), "moved block-lazy source is not empty");
+    auto* self = &moved;
+    moved = std::move (*self);
+    subject.intersect_with (moved);
+    check (subject, rows, rows);
+    subject.union_with (std::move (moved));
+    // Successful union consumes the RHS and clears its index state.
+    // NOLINTNEXTLINE(bugprone-use-after-move)
+    require (moved.empty (), "block-lazy union retained RHS");
+    check (subject, rows, rows);
+    subject.clear ();
+    require (subject.empty () and subject.storage ().frozen.filter_bytes == 0,
+             "clear retained block-lazy geometry");
+    subject.insert (vector<V> (rows.front ()));
+    check (subject, {rows.front ()}, rows);
+  }
+}
+
+int main () try {
+  using vector_type = posets::vectors::vector_backed<int16_t>;
+  oracle<vector_type, false, 0, false> ();
+  oracle<vector_type, false, 0, true> ();
+  oracle<vector_type, true, 0, false> ();
+  oracle<vector_type, true, 0, true> ();
+  oracle<vector_type, false, 1, false> ();
+  oracle<vector_type, false, 1, true> ();
+  oracle<vector_type, true, 1, false> ();
+  oracle<vector_type, true, 1, true> ();
+  oracle<vector_type, false, 2, false> ();
+  oracle<vector_type, false, 2, true> ();
+  oracle<vector_type, true, 2, false> ();
+  oracle<vector_type, true, 2, true> ();
+  oracle<posets::vectors::simd_vector_backed<int8_t>, true, 2, true> (false, true);
+  oracle<posets::vectors::vector_backed<int32_t>, true, 2, true> (false, true);
+  oracle<posets::vectors::vector_backed<int64_t>, true, 2, true> (false, true);
+  oracle<posets::vectors::vector_backed<float>, true, 2, true> ();
+  using wrapped_type =
+      posets::vectors::x_and_bitset<posets::vectors::simd_vector_backed<int8_t>, 3>;
+  oracle<wrapped_type, true, 2, true> (true);
+  algebra<posets::vectors::simd_vector_backed<int8_t>> ();
+  algebra<wrapped_type> ();
+  std::cout
+      << "Block-lazy scalar/SIMD columns, live guards, signed bounds, tails and algebra PASS\n";
+} catch (const std::exception& error) {
+  std::cerr << error.what () << '\n';
+  return 1;
+}
